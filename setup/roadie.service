[Unit]
Description=Roadie (KVM server: video, input and audio over HTTP)
Documentation=https://github.com/VibiumDev/roadie
Wants=network-online.target
# Ordered after the USB gadget when this Pi has one (linux-gadget backend).
# Not required: without it roadie still starts, serves video, and reports the
# HID backend unavailable in /health and /api/hid/status.
After=network-online.target sound.target roadie-gadget.service

[Service]
# roadie tells systemd when it serves and answers its watchdog every 15 s
# for as long as its own port answers; a roadie quiet for 30 s is restarted.
Type=notify
WatchdogSec=30
User=@ROADIE_USER@
# roadie: the gadget's HID nodes. audio, video: capture and USB audio.
# dialout: the relay board's serial port.
SupplementaryGroups=roadie audio video dialout
EnvironmentFile=-/etc/default/roadie
ExecStart=/usr/local/bin/roadie $ROADIE_ARGS
Restart=always
RestartSec=2
# Stopping roadie releases every key, button and finger it holds, then
# exits. It never touches the gadget, so the phone stays enumerated.
TimeoutStopSec=10

# The sandbox. The system is read-only to roadie, other accounts' homes are
# out of sight, /tmp is its own, and it keeps no capability but the one
# that binds ports below 1024 (--tls-cert on :443, --http-redirect :80).
# Its own files (the token, the rig key and policy, saved crops) live in
# the config directory of the account it runs as; setup/install-service
# fills in the home lines for that account.
@ROADIE_HOME@
StateDirectory=roadie
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Refused calls fail with an error instead of killing roadie.
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Only the device nodes roadie drives. /sys stays writable because the
# capture dongle's USB reset writes the driver's bind files, which a udev
# rule opens to group video; that is why ProtectKernelTunables is not set.
DevicePolicy=closed
DeviceAllow=char-video4linux rw
DeviceAllow=char-media rw
DeviceAllow=char-alsa rw
DeviceAllow=char-hidg rw
DeviceAllow=char-ttyACM rw
DeviceAllow=char-usb_device rw

[Install]
WantedBy=multi-user.target
