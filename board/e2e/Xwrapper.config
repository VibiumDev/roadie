# Installed by roadie's `make setup` to /etc/X11/Xwrapper.config
#
# Roadie's browser test runs on its own throwaway X display, so that the HID
# input it injects can only reach the browser and cannot land in whatever
# happens to have focus on a desktop.
#
# Starting an X server is restricted to console users by default, which fails
# over ssh -- the normal way to work on a dev Pi. This permits it, so the test
# needs no root at all.
#
# This does let any local user start an X server. That is a reasonable
# trade on a dedicated development or test machine; if this host is shared,
# remove this file and the test will fall back to using sudo.
allowed_users=anybody
needs_root_rights=yes
