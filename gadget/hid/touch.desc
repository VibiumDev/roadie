# Two-contact touchscreen: Roadie's own board/hid/digitizer.py, the
# descriptor the RP2040 HID board presents, with its Report ID removed.
#
# Input report, 13 bytes:
#   [id0, tip0, x0_lo, x0_hi, y0_lo, y0_hi,
#    id1, tip1, x1_lo, x1_hi, y1_lo, y1_hi, contact_count]
# x, y: 0-32767. Feature report: Contact Count Maximum (2).
05 0D        # Usage Page (Digitizer)
09 04        # Usage (Touch Screen)
A1 01        # Collection (Application)
05 0D        #   Usage Page (Digitizer)          -- contact 0
09 22        #   Usage (Finger)
A1 02        #   Collection (Logical)
09 51        #     Usage (Contact Identifier)
75 08        #     Report Size (8)
95 01        #     Report Count (1)
15 00        #     Logical Minimum (0)
25 01        #     Logical Maximum (1)
81 02        #     Input (Data,Var,Abs)
09 42        #     Usage (Tip Switch)
15 00        #     Logical Minimum (0)
25 01        #     Logical Maximum (1)
75 08        #     Report Size (8)
95 01        #     Report Count (1)
81 02        #     Input (Data,Var,Abs)
05 01        #     Usage Page (Generic Desktop)
09 30        #     Usage (X)
15 00        #     Logical Minimum (0)
26 FF 7F     #     Logical Maximum (32767)
75 10        #     Report Size (16)
95 01        #     Report Count (1)
81 02        #     Input (Data,Var,Abs)
09 31        #     Usage (Y)
15 00        #     Logical Minimum (0)
26 FF 7F     #     Logical Maximum (32767)
75 10        #     Report Size (16)
95 01        #     Report Count (1)
81 02        #     Input (Data,Var,Abs)
C0           #   End Collection
05 0D        #   Usage Page (Digitizer)          -- contact 1
09 22        #   Usage (Finger)
A1 02        #   Collection (Logical)
09 51        #     Usage (Contact Identifier)
75 08        #     Report Size (8)
95 01        #     Report Count (1)
15 00        #     Logical Minimum (0)
25 01        #     Logical Maximum (1)
81 02        #     Input (Data,Var,Abs)
09 42        #     Usage (Tip Switch)
15 00        #     Logical Minimum (0)
25 01        #     Logical Maximum (1)
75 08        #     Report Size (8)
95 01        #     Report Count (1)
81 02        #     Input (Data,Var,Abs)
05 01        #     Usage Page (Generic Desktop)
09 30        #     Usage (X)
15 00        #     Logical Minimum (0)
26 FF 7F     #     Logical Maximum (32767)
75 10        #     Report Size (16)
95 01        #     Report Count (1)
81 02        #     Input (Data,Var,Abs)
09 31        #     Usage (Y)
15 00        #     Logical Minimum (0)
26 FF 7F     #     Logical Maximum (32767)
75 10        #     Report Size (16)
95 01        #     Report Count (1)
81 02        #     Input (Data,Var,Abs)
C0           #   End Collection
05 0D        #   Usage Page (Digitizer)
09 54        #   Usage (Contact Count)
15 00        #   Logical Minimum (0)
25 02        #   Logical Maximum (2)
75 08        #   Report Size (8)
95 01        #   Report Count (1)
81 02        #   Input (Data,Var,Abs)
09 55        #   Usage (Contact Count Maximum)
15 00        #   Logical Minimum (0)
25 02        #   Logical Maximum (2)
75 08        #   Report Size (8)
95 01        #   Report Count (1)
B1 02        #   Feature (Data,Var,Abs)
C0           # End Collection
